# =====================================================================
# JARVIS configuration. Copy to .env and fill in the REQUIRED values.
# Never commit .env. Never share these values.
# =====================================================================

# ---------------------------------------------------------------- REQUIRED
# OpenRouter API key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Supabase project: Project Settings -> API (or "API Keys")
#   SUPABASE_URL = Project URL, e.g. https://abcdefgh.supabase.co
#   SUPABASE_KEY = the anon / publishable key. NEVER the service_role key.
SUPABASE_URL=
SUPABASE_KEY=

# The Supabase Auth user JARVIS signs in as (Authentication -> Users)
JARVIS_EMAIL=
JARVIS_PASSWORD=

# ElevenLabs API key (speech-to-text): https://elevenlabs.io/app/settings/api-keys
# Needs the "Speech to Text" permission (and "Text to Speech" if you use
# JARVIS_TTS_ENGINE=elevenlabs). Voice input is disabled if left empty.
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------- LLM
# Chat model. Must support tool calling. Browse: https://openrouter.ai/models
OPENROUTER_MODEL=openrouter/auto
# Optional comma-separated fallback chat models, used only for model or
# provider failures (never for rate limits or exhausted credits).
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TIMEOUT_SECONDS=60
# Retries for network errors, timeouts and 5xx provider errors.
OPENROUTER_MAX_RETRIES=2
# A rate-limited request is retried once only if the provider asks us to
# wait no longer than this many seconds.
OPENROUTER_MAX_RATE_LIMIT_WAIT=10
# Not used: memory search uses PostgreSQL full-text search, not embeddings.
JARVIS_EMBEDDING_MODEL=

# ---------------------------------------------------------------- conversation
JARVIS_MAX_HISTORY_TURNS=12
JARVIS_MAX_CONTEXT_CHARS=24000
JARVIS_MAX_TOOL_ROUNDS=5

# ---------------------------------------------------------------- voice
ELEVENLABS_STT_MODEL=scribe_v2
# Blank = automatic language detection. Example: en
ELEVENLABS_STT_LANGUAGE=
# Text-to-speech engine: pyttsx3 (offline, free, Windows voices),
# elevenlabs (online, uses ElevenLabs credits) or none
JARVIS_TTS_ENGINE=elevenlabs
# pyttsx3: part of a Windows voice name, e.g. David or Zira. Blank = default.
JARVIS_TTS_VOICE=
# pyttsx3 words per minute
JARVIS_TTS_RATE=185
# elevenlabs TTS only (falls back to the offline voice if ElevenLabs fails).
# Built-in voices: onwK4e9ZLuTAKqWW03F9 Daniel (British, calm),
# JBFqnCBsd6RMkjVDRZzb George (British, warm), nPczCjzI2devNBz1zQrb Brian (American, deep)
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# eleven_v4_turbo = expressive + real-time; eleven_flash_v2_5 = fastest and cheapest
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_TTS_SPEED=1.0
# Lower stability = more expressive and human; higher = steadier. Style adds emotion.
ELEVENLABS_TTS_STABILITY=0.45
ELEVENLABS_TTS_STYLE=0.25
# Terminal push-to-talk: microphone device index or name (blank = default)
JARVIS_MIC_DEVICE=
JARVIS_MAX_RECORD_SECONDS=15

# ---------------------------------------------------------------- PC tools
# Semicolon-separated folders JARVIS may read and write.
# Blank = the "workspace" folder inside this project.
JARVIS_ALLOWED_DIRS=
# Where reminders, tasks and audio cache are stored
JARVIS_DATA_DIR=data

# ---------------------------------------------------------------- HUD / logging
JARVIS_HUD_HOST=127.0.0.1
JARVIS_HUD_PORT=8765
JARVIS_LOG_LEVEL=INFO
